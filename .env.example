# Copy to .env or .env.local for the Express server (dev:server / start).
OPENAI_API_KEY=
# Optional: port for API + WebSocket (default 4000)
PORT=4000
# Optional: bind address (default 127.0.0.1)
BIND_HOST=127.0.0.1

# Optional: point Vite dev proxy at another host (default http://127.0.0.1:4000)
# VITE_API_TARGET=http://127.0.0.1:4000
